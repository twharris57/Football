{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "CLI: Rookie Draft (interactive)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/rookie_draft.py",
            "cwd": "${workspaceFolder}",
            "justMyCode": false,
            "console": "integratedTerminal"
        },
        {
            "name": "CLI: Rookie Draft (--once)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/rookie_draft.py",
            "args": ["--once"],
            "cwd": "${workspaceFolder}",
            "justMyCode": false,
            "console": "integratedTerminal"
        },
        {
            "name": "Web: Streamlit Dashboard",
            "type": "debugpy",
            "request": "launch",
            "module": "streamlit",
            "args": ["run", "streamlit_app.py"],
            "cwd": "${workspaceFolder}",
            "justMyCode": false,
            "console": "integratedTerminal"
        }
    ]
}
