{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Dynasty: Rookie Draft CLI (interactive)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/dynasty/rookie_draft.py",
            "cwd": "${workspaceFolder}",
            "justMyCode": false,
            "console": "integratedTerminal"
        },
        {
            "name": "Dynasty: Rookie Draft CLI (--once)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/dynasty/rookie_draft.py",
            "args": ["--once"],
            "cwd": "${workspaceFolder}",
            "justMyCode": false,
            "console": "integratedTerminal"
        },
        {
            "name": "Dynasty: Streamlit Dashboard",
            "type": "debugpy",
            "request": "launch",
            "module": "streamlit",
            "args": ["run", "dynasty/streamlit_app.py", "--server.headless=true"],
            "cwd": "${workspaceFolder}",
            "justMyCode": false,
            "console": "integratedTerminal"
        },
        {
            "name": "Confidence Pool: Streamlit App",
            "type": "debugpy",
            "request": "launch",
            "module": "streamlit",
            "args": ["run", "confidence_pool/streamlit_app.py", "--server.port=8502", "--server.headless=true"],
            "cwd": "${workspaceFolder}",
            "justMyCode": false,
            "console": "integratedTerminal"
        }
    ]
}
