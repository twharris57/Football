# Same base as the Streamlit images for consistency.
FROM python:3.12-slim

WORKDIR /app

# Minimal requirements: no pandas/streamlit/nfl_data_py.
COPY dynasty/scout_api/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY dynasty/scout_api ./dynasty/scout_api

RUN groupadd --system --gid 1000 app \
 && useradd --system --uid 1000 --gid app app \
 && mkdir -p /app/scout_data && chown -R app:app /app
USER app

# Created before USER app so the volume mounts app-owned.
VOLUME ["/app/scout_data"]

# Runs once per scheduled invocation; the exit code is the health signal.
# WORKDIR is dynasty/ so `python -m scout_api.sync` resolves the package.
WORKDIR /app/dynasty
CMD ["python", "-m", "scout_api.sync"]
