# Copy to .env and adjust as needed. Used by docker-compose.deploy.yml.
# Non-secret vars can keep a sensible inline default (the three HOST_PORT
# vars below); a secret is left blank here with a comment on where the
# value comes from.
DYNASTY_HOST_PORT=8501          # port the dynasty draft app listens on
CONFIDENCE_POOL_HOST_PORT=8502  # port the confidence pool app listens on
SCOUT_DATA_GITHUB_TOKEN=        # optional: a read-only GitHub token for the scout-data sync (dynasty/scout_api) - raises it past GitHub's 60 req/hour unauthenticated rate limit; not required against this public repo for a script run a few times a day
